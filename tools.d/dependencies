#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'open3'
require 'optparse'
require 'zip'
require 'sarif'

EXIT_SUCCESS = 0
EXIT_ISSUES = 1
EXIT_ERROR = 2

# The kinds of file this tool knows how to look for.
class FileType
  JAVASCRIPT = 'JavaScript'
  DLL = 'DLL'
  JAR = 'JAR'
end

# One unreferenced file, with whatever identifying metadata we could read from it.
class Finding
  attr_reader :file_path, :file_type, :metadata

  def initialize(file_path, file_type, metadata = '')
    @file_path = file_path
    @file_type = file_type
    @metadata = metadata
  end
end

# Looks for tracked files of interest that nothing else in the repository mentions.
class Checker
  # Tags worth reporting from a PE version resource, best first.
  DLL_METADATA_TAGS = %w[FileDescription FileVersion ProductName CompanyName].freeze

  # Manifest entries worth reporting from a JAR.
  JAR_MANIFEST_KEYS = %w[Implementation-Title Implementation-Version].freeze

  def initialize(directory)
    @root_dir = File.expand_path(directory)
  end

  private

  # Every external command goes through here. Passing argv as separate arguments means
  # no shell is involved, so paths and search patterns containing spaces, quotes or
  # glob characters need no escaping. Returns nil when the command fails or is absent.
  def run(*argv)
    out, _err, status = Open3.capture3(*argv)
    status.success? ? out : nil
  rescue Errno::ENOENT
    nil
  end

  def tool_available?(name)
    @available ||= {}
    @available[name] = !run(name, '--version').nil? unless @available.key?(name)
    @available[name]
  end

  def get_git_files(patterns)
    patterns.flat_map do |pattern|
      out = run('git', '-C', @root_dir, 'ls-files', pattern)
      out ? out.each_line.map(&:strip).reject(&:empty?) : []
    end
  end

  # exiftool reads the PE version resource itself. The previous approach - strings(1)
  # filtered for lines mentioning "Version" or "AssemblyTitle" - picked up whatever
  # string happened to come first, which on a .NET assembly is typically a *referenced*
  # assembly such as mscorlib rather than this file.
  def get_dll_metadata(file_path)
    return '' unless exiftool?

    out = run('exiftool', '-json', *DLL_METADATA_TAGS.map { |t| "-#{t}" },
              File.join(@root_dir, file_path))
    out ? describe_tags(JSON.parse(out).first) : ''
  rescue JSON::ParserError
    ''
  end

  # The two most informative tags exiftool could read, as "Tag: value".
  def describe_tags(tags)
    tags ||= {}
    DLL_METADATA_TAGS.filter_map { |t| "#{t}: #{tags[t]}" if tags[t] }.take(2).join(', ')
  end

  def exiftool?
    return true if tool_available?('exiftool')

    warn_once('exiftool', 'DLL version metadata will be omitted')
    false
  end

  def manifest_metadata(manifest)
    metadata = []
    manifest.get_input_stream.read.each_line do |line|
      next unless JAR_MANIFEST_KEYS.any? { |key| line.include?(key) }

      metadata << line.strip
      break if metadata.size >= 2
    end
    metadata.join(' ')
  end

  def get_jar_metadata(file_path)
    Zip::File.open(File.join(@root_dir, file_path)) do |zip_file|
      manifest = zip_file.find { |f| f.name == 'META-INF/MANIFEST.MF' }
      return manifest ? manifest_metadata(manifest) : ''
    end

    ''
  end

  def warn_once(tool, consequence)
    @warned ||= {}
    return if @warned[tool]

    @warned[tool] = true
    warn "Warning: '#{tool}' is not installed (#{consequence}). Install it with: brew install #{tool}"
  end

  # The .csproj list is the same for every file we check, so read it once.
  def csproj_contents
    @csproj_contents ||= get_git_files(['*.csproj']).filter_map do |csproj_file|
      full_path = File.join(@root_dir, csproj_file)
      File.read(full_path) if File.exist?(full_path)
    end
  end

  def file_referenced_in_csproj?(basename)
    csproj_contents.any? { |content| content.match?(/<HintPath>.+#{Regexp.escape(basename)}/i) }
  end

  # Literal strings to look for: the filename, the filename without its extension, and
  # the path without its extension.
  def reference_patterns(file_path)
    [File.basename(file_path),
     File.basename(file_path, File.extname(file_path)),
     file_path.sub(/\.[^.]+$/, '')].uniq
  end

  # True when some file other than file_path itself mentions the pattern. .csproj files
  # are excluded because they are handled separately, by HintPath.
  def mentioned_elsewhere?(pattern, file_path)
    # --fixed-strings for exact string matching, --files-with-matches for names only
    out = run('rg', '--fixed-strings', '--files-with-matches', '--', pattern, @root_dir)
    return false unless out

    out.each_line.any? do |line|
      match_file = line.chomp.delete_prefix("#{@root_dir}/")
      match_file != file_path && !match_file.downcase.end_with?('.csproj')
    end
  end

  def file_referenced?(file_path)
    unless tool_available?('rg')
      warn "Error: 'rg' is not installed. Install it with: brew install ripgrep"
      exit EXIT_ERROR
    end

    # First check if file is referenced in .csproj files as a <Reference>
    return true if file_referenced_in_csproj?(File.basename(file_path))

    reference_patterns(file_path).any? { |pattern| mentioned_elsewhere?(pattern, file_path) }
  end

  public

  def check_javascript_files
    extensions = ['*.js']
    files = get_git_files(extensions)

    findings = []
    files.each do |file|
      findings << Finding.new(file, FileType::JAVASCRIPT) unless file_referenced?(file)
    end

    findings
  end

  def check_dll_files
    files = get_git_files(['*.dll'])

    findings = []
    files.each do |file|
      unless file_referenced?(file)
        metadata = get_dll_metadata(file)
        findings << Finding.new(file, FileType::DLL, metadata)
      end
    end

    findings
  end

  def check_jar_files
    files = get_git_files(['*.jar'])

    findings = []
    files.each do |file|
      unless file_referenced?(file)
        metadata = get_jar_metadata(file)
        findings << Finding.new(file, FileType::JAR, metadata)
      end
    end

    findings
  end
end

# Color constants for terminal output
RED = "\033[0;31m"
YELLOW = "\033[1;33m"
RESET = "\033[0m"

def git_repository?(directory)
  _out, _err, status = Open3.capture3('git', '-C', directory, 'rev-parse', '--git-dir')
  status.success?
rescue Errno::ENOENT
  false
end

def output_text(findings)
  findings.each do |f|
    file_type = "#{f.file_type} not referenced:"
    if f.metadata && !f.metadata.empty?
      puts "#{RED}#{file_type}#{RESET} #{f.file_path} #{YELLOW}(#{f.metadata})#{RESET}"
    else
      puts "#{RED}#{file_type}#{RESET} #{f.file_path}"
    end
  end
end

DEPSPOT_URI = 'https://github.com/simpsonjulian/depspot'

RULES = {
  FileType::JAVASCRIPT => ['unreferenced-javascript', 'JavaScript file not referenced in codebase'],
  FileType::DLL => ['unreferenced-dll', 'DLL file not referenced in codebase'],
  FileType::JAR => ['unreferenced-jar', 'JAR file not referenced in codebase']
}.freeze

def sarif_rules
  RULES.map do |_type, (id, description)|
    Sarif::ReportingDescriptor.new(
      id: id,
      short_description: Sarif::MultiformatMessageString.new(text: description),
      help_uri: DEPSPOT_URI
    )
  end
end

def sarif_result(finding)
  rule_id, = RULES[finding.file_type]
  message = "#{finding.file_type} file not referenced in codebase"
  message += " (#{finding.metadata})" if finding.metadata && !finding.metadata.empty?

  Sarif::Result.new(
    rule_id: rule_id,
    level: 'warning',
    message: Sarif::Message.new(text: message),
    locations: [
      Sarif::Location.new(
        physical_location: Sarif::PhysicalLocation.new(
          artifact_location: Sarif::ArtifactLocation.new(uri: finding.file_path)
        )
      )
    ]
  )
end

def output_sarif(findings)
  sarif = Sarif::Log.new(
    version: '2.1.0',
    runs: [
      Sarif::Run.new(
        tool: Sarif::Tool.new(
          driver: Sarif::ToolComponent.new(
            name: 'depspot', information_uri: DEPSPOT_URI, version: '1.0.0', rules: sarif_rules
          )
        ),
        results: findings.map { |f| sarif_result(f) }
      )
    ]
  )

  # sarif-ruby drops "results" entirely when the array is empty, and sarif-tools then
  # dies with KeyError: 'results', taking down statica's whole console summary rather
  # than just this report. Finding nothing is the normal case, so force the key back in.
  doc = sarif.to_h
  doc['runs'].each { |r| r['results'] ||= [] }
  puts JSON.pretty_generate(doc)
end

def print_usage
  puts <<~USAGE
    Usage: depspot PATH [OPTIONS]

    Find project files that aren't referenced in code

    Arguments:
      PATH               Directory to scan (required)

    Options:
      --no-sarif         Output in plain text instead of SARIF format
      -h, --help         Show this help message

    By default, outputs SARIF format and checks all file types (JavaScript, DLL, JAR).
  USAGE
end

# Parse command line options
options = {
  sarif: true,
  directory: nil
}

OptionParser.new do |opts|
  opts.on('--no-sarif', 'Output in plain text instead of SARIF') { options[:sarif] = false }
  opts.on('-h', '--help', 'Show help message') do
    print_usage
    exit EXIT_SUCCESS
  end
end.parse!

# Get directory from first argument
options[:directory] = ARGV[0]

unless options[:directory]
  warn 'Error: PATH argument is required'
  puts ''
  print_usage
  exit EXIT_ERROR
end

unless git_repository?(options[:directory])
  warn 'Error: Not in a git repository'
  exit EXIT_ERROR
end

# Initialize checker
checker = Checker.new(options[:directory])
results = []

# Run all checks
begin
  results.concat(checker.check_javascript_files)
  results.concat(checker.check_dll_files)
  results.concat(checker.check_jar_files)
rescue StandardError => e
  warn "Error checking files: #{e.message}"
  exit EXIT_ERROR
end

# Output results
if options[:sarif]
  output_sarif(results)
else
  output_text(results)
end
