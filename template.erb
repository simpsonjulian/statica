<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Findings Report</title>
  <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
  <style>
      .warning {
          color: #f39c12;
      }

      .warning::after {
          content: "⚠️";
      }

      .error {
          color: #e74c3c;
      }

      .error::after {
          content: "❌";
      }

      .note {
          color: #3498db;
      }

      .note::after {
          content: "📝";
      }

      .collapsible:hover {
          background-color: #ddd;
      }

      body {
          font-family: 'Helvetica', 'Arial', sans-serif;
          font-size: 16px;
          line-height: 1.6;
          margin: 0;
          padding: 0;
          background-color: #f4f4f4;
          color: #333;
      }

      .container {
          width: 80%;
          margin: 20px auto;
          background: #fff;
          padding: 20px;
          box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }

      .severity {
          font-size: 20px;
          font-weight: bold;
          margin: 20px 0 10px;
      }

      .header-container {
          display: flex;
          justify-content: center;
          margin: auto;
      }

      .header {
          text-align: left;
          display: inline-block;
          padding: 20px;
          margin-bottom: 20px;
          background-color: #f4f4f4;
          border-bottom: 1px solid #ddd;
      }

      h1 {
          margin: 0;
          text-align: center;
          font-size: 24px;
          color: #444;
      }

      #graph-container {
          width: 100%;
          height: 600px;
          border: 1px solid #ddd;
          margin: 20px 0;
      }

      /* Findings scoped to a ref rather than a file have nothing to link to */
      .logical-location {
          font-family: monospace;
          color: #555;
      }

      .hotspot-files table {
          width: 100%;
          border-collapse: collapse;
      }

      .hotspot-files th,
      .hotspot-files td {
          border: 1px solid #ddd;
          padding: 8px;
          text-align: left;
      }

      .hotspot-files th {
          background-color: #f4f4f4;
          font-weight: bold;
      }

      .hotspot-files tr:hover {
          background-color: #f9f9f9;
      }

      .widespread-findings table {
          width: 100%;
          border-collapse: collapse;
      }

      .widespread-findings th,
      .widespread-findings td {
          border: 1px solid #ddd;
          padding: 8px;
          text-align: left;
      }

      .widespread-findings th {
          background-color: #f4f4f4;
          font-weight: bold;
      }

      .widespread-findings tr:hover {
          background-color: #f9f9f9;
      }

      .ai-assist-section {
          margin: 20px 0;
          padding: 15px 20px;
          background-color: #f9f9f9;
          border: 1px solid #ddd;
          border-radius: 4px;
      }

      .ai-assist-buttons {
          display: flex;
          flex-wrap: wrap;
          gap: 10px;
          margin: 10px 0;
      }

      .ai-assist-buttons button {
          padding: 8px 14px;
          font-size: 14px;
          border: 1px solid #ccc;
          border-radius: 4px;
          background-color: #fff;
          cursor: pointer;
      }

      .ai-assist-buttons button:hover {
          background-color: #eee;
      }

      .ai-assist-status {
          font-size: 14px;
          color: #3498db;
          min-height: 1.2em;
      }
  </style>
</head>
<body>
<div class="container">
  <div class="header-container">


    <div class="header">


      <h1>Statica AppSec Findings</h1>
      <p><strong>Repository URL:</strong> <a href="<%= ENV['REPO_URL'] %>" target="_blank"><%= ENV['REPO_URL'] %></a>
      </p>
      <p><strong>Repo Branch:</strong> <%= ENV['REPO_BRANCH'] %></p>
      <p><strong>Latest Commit SHA:</strong> <%= ENV['LATEST_COMMIT_SHA'] %></p>
      <p><strong>Scan Date:</strong> <%= @scan_date %></p>
      <p><strong>Findings:</strong> <%= @results.length %></p>
      <p><strong>Tools used:</strong> <%= @tools.join(", ") %></p>
    </div>
  </div>

  <div class="ai-assist-section">
    <h2>Ask an AI About These Findings</h2>
    <p>Copy a summary of these findings and open it in a chatbot you already use. Nothing is sent anywhere
      automatically, no API key is involved, and you choose which AI &mdash; if any &mdash; sees the data.</p>
    <div class="ai-assist-buttons">
      <button type="button" id="ai-copy-btn">Copy prompt</button>
      <button type="button" data-ai-open="https://claude.ai/new">Open in Claude</button>
      <button type="button" data-ai-open="https://chatgpt.com/">Open in ChatGPT</button>
      <button type="button" data-ai-open="https://gemini.google.com/app">Open in Gemini</button>
    </div>
    <p id="ai-assist-status" class="ai-assist-status" aria-live="polite"></p>
  </div>

  <script>
      window.STATICA_FINDINGS = <%= @results.map(&:to_h).to_json %>;
      window.STATICA_META = {
          repoUrl: <%= ENV['REPO_URL'].to_s.to_json %>,
          repoBranch: <%= ENV['REPO_BRANCH'].to_s.to_json %>,
          commitSha: <%= ENV['LATEST_COMMIT_SHA'].to_s.to_json %>,
          scanDate: <%= @scan_date.to_s.to_json %>,
          tools: <%= @tools.to_json %>
      };
  </script>

  <script>
      (function () {
          var MAX_FILES_PER_RULE = 10;
          var SEVERITY_ORDER = ['error', 'warning', 'note'];

          function decodeEntities(str) {
              var el = document.createElement('textarea');
              el.innerHTML = str;
              return el.value;
          }

          function buildPrompt() {
              var findings = window.STATICA_FINDINGS || [];
              var meta = window.STATICA_META || {};
              var bySeverity = {};

              findings.forEach(function (f) {
                  bySeverity[f.severity] = bySeverity[f.severity] || {};
                  var group = bySeverity[f.severity][f.rule_id] || {
                      description: decodeEntities(f.description),
                      tool: f.tool,
                      locations: []
                  };
                  if (!f.file_url) {
                      // Ref-scoped finding: no file to cite, so name the branch instead
                      group.locations.push(f.logical_location || 'repository');
                  } else {
                      group.locations.push(f.linenum > 0 ? (f.file_url + ':' + f.linenum) : f.file_url);
                  }
                  bySeverity[f.severity][f.rule_id] = group;
              });

              var lines = [];
              lines.push('I ran a static application security testing (SAST) scan on my codebase and want your opinion on the results.');
              lines.push('');
              lines.push('Repository: ' + (meta.repoUrl || 'unknown') + ' (branch ' + (meta.repoBranch || 'unknown') + ', commit ' + (meta.commitSha || 'unknown') + ')');
              lines.push('Scan date: ' + (meta.scanDate || 'unknown'));
              lines.push('Tools used: ' + ((meta.tools && meta.tools.join(', ')) || 'unknown'));
              lines.push('Total findings: ' + findings.length);
              lines.push('');

              SEVERITY_ORDER.forEach(function (severity) {
                  var rules = bySeverity[severity];
                  if (!rules) return;

                  lines.push('== ' + severity.toUpperCase() + ' ==');
                  Object.keys(rules).forEach(function (ruleId) {
                      var group = rules[ruleId];
                      var count = group.locations.length;
                      lines.push('- ' + ruleId + ' [' + group.tool + '] (' + count + ' occurrence' + (count === 1 ? '' : 's') + ')');
                      lines.push('  ' + group.description);
                      var shown = group.locations.slice(0, MAX_FILES_PER_RULE);
                      var more = count - shown.length;
                      lines.push('  Files: ' + shown.join(', ') + (more > 0 ? ', and ' + more + ' more' : ''));
                  });
                  lines.push('');
              });

              lines.push('Please tell me: which of these vulnerabilities are of real concern, what could or ' +
                  'should be changed to address them, and which should be fixed first.');

              return lines.join('\n');
          }

          function copyText(text) {
              if (navigator.clipboard && window.isSecureContext) {
                  return navigator.clipboard.writeText(text);
              }

              // navigator.clipboard requires a secure context, which a report opened
              // directly via file:// does not reliably get. Fall back to the classic
              // hidden-textarea + execCommand trick so "Copy prompt" still works there.
              var textarea = document.createElement('textarea');
              textarea.value = text;
              textarea.setAttribute('readonly', '');
              textarea.style.position = 'fixed';
              textarea.style.opacity = '0';
              document.body.appendChild(textarea);
              textarea.focus();
              textarea.select();
              try {
                  document.execCommand('copy');
              } finally {
                  document.body.removeChild(textarea);
              }
              return Promise.resolve();
          }

          document.addEventListener('DOMContentLoaded', function () {
              var status = document.getElementById('ai-assist-status');

              function setStatus(message) {
                  status.textContent = message;
              }

              var copyBtn = document.getElementById('ai-copy-btn');
              if (copyBtn) {
                  copyBtn.addEventListener('click', function () {
                      copyText(buildPrompt()).then(function () {
                          setStatus('Copied to clipboard.');
                      }, function () {
                          setStatus('Could not copy automatically — please select and copy the prompt manually.');
                      });
                  });
              }

              Array.prototype.forEach.call(document.querySelectorAll('[data-ai-open]'), function (btn) {
                  btn.addEventListener('click', function () {
                      var url = btn.getAttribute('data-ai-open');
                      copyText(buildPrompt()).then(function () {
                          setStatus('Copied to clipboard — paste it into the chat that just opened.');
                      }, function () {
                          setStatus('Could not copy automatically — please copy the prompt manually before pasting.');
                      });
                      window.open(url, '_blank', 'noopener');
                  });
              });
          });
      })();
  </script>

  <div class="graph-section">
    <h2>Findings Graph</h2>
    <p>Interactive visualization of files with 3+ findings and their relationships. Drag nodes to reorganize, scroll to
      zoom:</p>
    <div id="graph-container"></div>
  </div>

  <% severities.each do |severity| %>

    <p class="severity <%= severity %>">
      <%= severity %>
    </p>

    <% rules_and_descriptions(severity).each_pair do |rule_id, desc| %>

      <% results_matching = results_matching(severity, rule_id) %>

      <p class="collapsible <%= results_matching.length <= 5 ? 'active' : '' %>">
        <b><%= rule_id %></b>:
        <%= desc %>
        <em>[ <%= results_matching.first.tool %>] </em>
        <strong>(<%= results_matching.length %>)</strong>
      </p>

      <ul>
        <% results_matching.each do |finding| %>
          <li>
            <% if finding.file_url %>
              <a href="<%= get_url(finding.file_url, finding.linenum) %>" target="_blank"><%= finding.file_url %></a><%= finding.linenum > 0 ? ":#{finding.linenum}" : nil %>
            <% else %>
              <span class="logical-location"><%= finding.logical_location || 'repository' %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>


  <% end %>

  <script>
      document.addEventListener("DOMContentLoaded", function () {
          // Collapsible sections
          let coll = document.getElementsByClassName("collapsible");
          for (let i = 0; i < coll.length; i++) {
              let content = coll[i].nextElementSibling;
              if (coll[i].classList.contains("active")) {
                  content.style.display = "block";
              } else {
                  content.style.display = "none";
              }
              coll[i].addEventListener("click", function () {
                  this.classList.toggle("active");
                  if (content.style.display === "block") {
                      content.style.display = "none";
                  } else {
                      content.style.display = "block";
                  }
              });
          }

          // Initialize vis.js graph
          var container = document.getElementById('graph-container');
          var graphData = <%= @graph_analyzer.to_visjs_json(3) %>;

          // Pin the "analysis" (tool/check) nodes evenly around the perimeter and
          // take them out of the physics simulation. Left to forceAtlas2Based they
          // drift toward the same low-mass equilibrium near the file clusters and
          // end up overlapping each other; fixing them on a circle spreads them
          // apart and keeps them out of the way of the file/finding cluster in the
          // middle, while their connected finding nodes are still free to be pulled
          // toward them.
          var checkNodes = graphData.nodes.filter(function (node) {
              return node.id.indexOf('analysis:') === 0;
          });
          var checkRadius = Math.max(300, checkNodes.length * 60);
          checkNodes.forEach(function (node, index) {
              var angle = (2 * Math.PI * index) / checkNodes.length;
              node.x = checkRadius * Math.cos(angle);
              node.y = checkRadius * Math.sin(angle);
              node.physics = false;
          });

          var options = {
              nodes: {
                  font: {
                      size: 14
                  },
                  fixed: false
              },
              edges: {
                  font: {
                      size: 10,
                      align: 'middle'
                  },
                  smooth: {
                      type: 'cubicBezier',
                      forceDirection: 'horizontal'
                  }
              },
              layout: {
                  improvedLayout: true
              },
              physics: {
                  enabled: true,
                  solver: 'forceAtlas2Based',
                  // forceAtlas2Based scales both the pull-to-center (centralGravity)
                  // and the repulsion between nodes by mass * degree, so raising
                  // centralGravity is what actually anchors high-mass/high-degree
                  // file nodes at the center and lets their (also mass-scaled)
                  // repulsion push the attached, low-mass finding nodes outward.
                  // At the previous default (0.01) that pull was negligible next
                  // to gravitationalConstant, so the layout had no real hub/leaf
                  // structure.
                  forceAtlas2Based: {
                      gravitationalConstant: -50,
                      centralGravity: 0.08,
                      springLength: 150,
                      springConstant: 0.08,
                      damping: 0.4,
                      avoidOverlap: 0.5
                  },
                  stabilization: {
                      enabled: true,
                      iterations: 200,
                      updateInterval: 25
                  }
              },
              manipulation: {
                  enabled: false
              },
              interaction: {
                  dragNodes: true,
                  dragView: true,
                  zoomView: true,
                  hover: true
              }
          };

          var network = new vis.Network(container, graphData, options);

          // Allow individual node dragging
          network.on("dragStart", function (params) {
              if (params.nodes.length > 0) {
                  network.selectNodes([params.nodes[0]]);
              }
          });

          // Stop physics after stabilization for better performance
          network.on("stabilizationIterationsDone", function () {
              network.setOptions({physics: false});
          });
      });
  </script>
</div>

</body>
</html>
