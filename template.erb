<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Findings Report</title>
  <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
  <style>
      .warning {
          color: #f39c12;
      }

      .warning::after {
          content: "⚠️";
      }

      .error {
          color: #e74c3c;
      }

      .error::after {
          content: "❌";
      }

      .note {
          color: #3498db;
      }

      .note::after {
          content: "📝";
      }

      .collapsible:hover {
          background-color: #ddd;
      }

      body {
          font-family: 'Helvetica', 'Arial', sans-serif;
          font-size: 16px;
          line-height: 1.6;
          margin: 0;
          padding: 0;
          background-color: #f4f4f4;
          color: #333;
      }

      .container {
          width: 80%;
          margin: 20px auto;
          background: #fff;
          padding: 20px;
          box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }

      .severity {
          font-size: 20px;
          font-weight: bold;
          margin: 20px 0 10px;
      }

      .header-container {
          display: flex;
          justify-content: center;
          margin: auto;
      }

      .header {
          text-align: left;
          display: inline-block;
          padding: 20px;
          margin-bottom: 20px;
          background-color: #f4f4f4;
          border-bottom: 1px solid #ddd;
      }

      h1 {
          margin: 0;
          text-align: center;
          font-size: 24px;
          color: #444;
      }

      #graph-container {
          width: 100%;
          height: 600px;
          border: 1px solid #ddd;
          margin: 20px 0;
      }

      .hotspot-files table {
          width: 100%;
          border-collapse: collapse;
      }

      .hotspot-files th,
      .hotspot-files td {
          border: 1px solid #ddd;
          padding: 8px;
          text-align: left;
      }

      .hotspot-files th {
          background-color: #f4f4f4;
          font-weight: bold;
      }

      .hotspot-files tr:hover {
          background-color: #f9f9f9;
      }

      .widespread-findings table {
          width: 100%;
          border-collapse: collapse;
      }

      .widespread-findings th,
      .widespread-findings td {
          border: 1px solid #ddd;
          padding: 8px;
          text-align: left;
      }

      .widespread-findings th {
          background-color: #f4f4f4;
          font-weight: bold;
      }

      .widespread-findings tr:hover {
          background-color: #f9f9f9;
      }
  </style>
</head>
<body>
<div class="container">
  <div class="header-container">


    <div class="header">


      <h1>Statica AppSec Findings</h1>
      <p><strong>Repository URL:</strong> <a href="<%= ENV['REPO_URL'] %>" target="_blank"><%= ENV['REPO_URL'] %></a>
      </p>
      <p><strong>Repo Branch:</strong> <%= ENV['REPO_BRANCH'] %></p>
      <p><strong>Latest Commit SHA:</strong> <%= ENV['LATEST_COMMIT_SHA'] %></p>
      <p><strong>Scan Date:</strong> <%= @scan_date %></p>
      <p><strong>Findings:</strong> <%= @results.length %></p>
      <p><strong>Tools used:</strong> <%= @tools.join(", ") %></p>
    </div>
  </div>

  <div class="graph-section">
    <h2>Findings Graph</h2>
    <p>Interactive visualization of files with 3+ findings and their relationships. Drag nodes to reorganize, scroll to
      zoom:</p>
    <div id="graph-container"></div>
  </div>

  <% severities.each do |severity| %>

    <p class="severity <%= severity %>">
      <%= severity %>
    </p>

    <% rules_and_descriptions(severity).each_pair do |rule_id, desc| %>

      <% results_matching = results_matching(severity, rule_id) %>

      <p class="collapsible <%= results_matching.length <= 5 ? 'active' : '' %>">
        <b><%= rule_id %></b>:
        <%= desc %>
        <em>[ <%= results_matching.first.tool %>] </em>
        <strong>(<%= results_matching.length %>)</strong>
      </p>

      <ul>
        <% results_matching.each do |finding| %>
          <li>
            <a href="<%= get_url(finding.file_url, finding.linenum) %>" target="_blank"><%= finding.file_url %></a><%= finding.linenum > 0 ? ":#{finding.linenum}" : nil %>
          </li>
        <% end %>
      </ul>
    <% end %>


  <% end %>

  <script>
      document.addEventListener("DOMContentLoaded", function () {
          // Collapsible sections
          let coll = document.getElementsByClassName("collapsible");
          for (let i = 0; i < coll.length; i++) {
              let content = coll[i].nextElementSibling;
              if (coll[i].classList.contains("active")) {
                  content.style.display = "block";
              } else {
                  content.style.display = "none";
              }
              coll[i].addEventListener("click", function () {
                  this.classList.toggle("active");
                  if (content.style.display === "block") {
                      content.style.display = "none";
                  } else {
                      content.style.display = "block";
                  }
              });
          }

          // Initialize vis.js graph
          var container = document.getElementById('graph-container');
          var graphData = <%= @graph_analyzer.to_visjs_json(3) %>;

          // Pin the "analysis" (tool/check) nodes evenly around the perimeter and
          // take them out of the physics simulation. Left to forceAtlas2Based they
          // drift toward the same low-mass equilibrium near the file clusters and
          // end up overlapping each other; fixing them on a circle spreads them
          // apart and keeps them out of the way of the file/finding cluster in the
          // middle, while their connected finding nodes are still free to be pulled
          // toward them.
          var checkNodes = graphData.nodes.filter(function (node) {
              return node.id.indexOf('analysis:') === 0;
          });
          var checkRadius = Math.max(300, checkNodes.length * 60);
          checkNodes.forEach(function (node, index) {
              var angle = (2 * Math.PI * index) / checkNodes.length;
              node.x = checkRadius * Math.cos(angle);
              node.y = checkRadius * Math.sin(angle);
              node.physics = false;
          });

          var options = {
              nodes: {
                  font: {
                      size: 14
                  },
                  fixed: false
              },
              edges: {
                  font: {
                      size: 10,
                      align: 'middle'
                  },
                  smooth: {
                      type: 'cubicBezier',
                      forceDirection: 'horizontal'
                  }
              },
              layout: {
                  improvedLayout: true
              },
              physics: {
                  enabled: true,
                  solver: 'forceAtlas2Based',
                  // forceAtlas2Based scales both the pull-to-center (centralGravity)
                  // and the repulsion between nodes by mass * degree, so raising
                  // centralGravity is what actually anchors high-mass/high-degree
                  // file nodes at the center and lets their (also mass-scaled)
                  // repulsion push the attached, low-mass finding nodes outward.
                  // At the previous default (0.01) that pull was negligible next
                  // to gravitationalConstant, so the layout had no real hub/leaf
                  // structure.
                  forceAtlas2Based: {
                      gravitationalConstant: -50,
                      centralGravity: 0.08,
                      springLength: 150,
                      springConstant: 0.08,
                      damping: 0.4,
                      avoidOverlap: 0.5
                  },
                  stabilization: {
                      enabled: true,
                      iterations: 200,
                      updateInterval: 25
                  }
              },
              manipulation: {
                  enabled: false
              },
              interaction: {
                  dragNodes: true,
                  dragView: true,
                  zoomView: true,
                  hover: true
              }
          };

          var network = new vis.Network(container, graphData, options);

          // Allow individual node dragging
          network.on("dragStart", function (params) {
              if (params.nodes.length > 0) {
                  network.selectNodes([params.nodes[0]]);
              }
          });

          // Stop physics after stabilization for better performance
          network.on("stabilizationIterationsDone", function () {
              network.setOptions({physics: false});
          });
      });
  </script>
</div>

</body>
</html>
