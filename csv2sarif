#!/usr/bin/env ruby
# frozen_string_literal: true

require 'csv'
require_relative 'statica_sarif'

# Turns a findings CSV into SARIF, for the shell scanners that have no Ruby of their own.
# Columns, in order: rule_id, severity, message, uri, start_line, end_line.

LEVELS = { 'info' => 'note', 'low' => 'note', 'medium' => 'warning',
           'high' => 'error', 'critical' => 'error' }.freeze

tool_name, tool_version, findings_csv = ARGV
report = Statica::Report.new(tool_name, version: tool_version)

CSV.foreach(findings_csv) do |row|
  rule_id, severity, message, uri, start_line, end_line = row
  level = LEVELS.fetch(severity, severity)
  # The CSV carries no rule descriptions, so the finding's own message stands in.
  report.rule(rule_id, message, level: level)
  report.add(rule_id, message, uri: uri, line: start_line, end_line: end_line, level: level)
end

report.emit
