#!/bin/bash

set -euo pipefail

usage() {
  echo "Usage: $0 <path to app source> [console|html]"
  exit 1
}

run_command() {
  local bin="${brew_prefix}/bin"
  local libexec="${brew_prefix}/opt/statica/libexec"
  # Keep the caller's PATH (rbenv shims, bundler binstubs, etc.) ahead of
  # brew_prefix, which is only a fallback for tools not already resolvable
  # (e.g. semgrep, bearer). Putting brew_prefix first previously shadowed
  # rbenv's ruby with Homebrew's, breaking `bundle exec ./statica . html`.
  PATH="${app_dir}:${PATH}:${bin}:${libexec}" "$@"
}

if [ $# -lt 2 ]; then
  usage
fi

REPO_URL=''
REPO_BRANCH=''
LATEST_COMMIT_SHA=''

tmpdir=$(mktemp -d)
path_to_file="$(readlink -f "$0")"
app_dir=$(dirname "$path_to_file")
if which brew > /dev/null; then
  brew_prefix=$(brew --prefix)
else
 brew_prefix="/usr/local"
fi

source=$1
shift
source_abs=$(cd "${source}" && pwd)

for arg in "$@"; do
  if [ "$arg" != "console" ] && [ "$arg" != "html" ]; then
    usage
  fi
done


modes="$*"

if [ -d "${app_dir}/tools.d" ]; then
  tools_dir="${app_dir}/tools.d"
else

  tools_dir="${brew_prefix}/opt/statica/libexec/tools.d"
fi

echo "Scanning ${source}"
pids=()
for scanner in "${tools_dir}"/*; do
  name=$(basename "${scanner}")
  report="${tmpdir}/${name}.sarif"
  status="${tmpdir}/${name}.status"
  errlog="${tmpdir}/${name}.log"

  (
    if run_command "$scanner" "$source" > "${report}" 2> "${errlog}"; then
      chars=$(wc -c < "${report}" | tr -d " ")
      echo "[OK] Ran ${name} and put ${chars} characters of sarif file in ${report}" > "${status}"
    else
      echo "[NOT OK] There was an error running ${name}. No report saved." > "${status}"
      rm -f "${report}"
    fi
  ) &
  pids+=("$!")
done

for pid in "${pids[@]}"; do
  wait "${pid}"
done

for scanner in "${tools_dir}"/*; do
  name=$(basename "${scanner}")
  cat "${tmpdir}/${name}.status"
  if [ -s "${tmpdir}/${name}.log" ]; then
    sed "s/^/  [${name}] /" "${tmpdir}/${name}.log"
  fi
done
echo "Scanning complete.  Reports found:"
(cd "${tmpdir}" && ls -- *.sarif)


# console output
if [[ "${modes}" =~ 'console' ]]; then

  # stop bearer output confusing the sarif library
  if grep -q 'results":null' "$tmpdir"/bearer.sarif; then
    rm -f "$tmpdir"/bearer.sarif
  fi
  echo "Summary:"
  sarif summary "${tmpdir}"/*.sarif
fi
# html output
if [[ "${modes}" =~ "html" ]]; then

  html_report="${source}/statica.html"
  REPO_URL=$(cd "${source}" && git config --get remote.origin.url || echo "unknown")
  REPO_BRANCH=$(cd "${source}" && git rev-parse --abbrev-ref HEAD || echo "unknown")
  LATEST_COMMIT_SHA=$(cd "${source}" && git rev-parse --short HEAD || echo "unknown")

  export REPO_URL REPO_BRANCH LATEST_COMMIT_SHA

  run_command html_report.rb "${tmpdir}" "${html_report}" "${source_abs}"
  echo "HTML report at:"
  echo "${html_report}"
fi

rm -rf "${tmpdir}"
